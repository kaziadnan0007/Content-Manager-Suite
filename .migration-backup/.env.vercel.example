# Vercel Environment Variables
# Copy these to your Vercel project settings → Environment Variables

# Required: Your API server URL (where the backend is deployed)
VITE_API_URL=https://your-api-server.railway.app

# Optional: Session secret for the API server (if deploying backend to Railway/Render)
SESSION_SECRET=your-super-secret-key-here

# Optional: Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/acholgatha
